# Copy to .env.local for local overrides. .env.local is gitignored.

# 'mock' (default) runs entirely against in-memory fixtures -- no network
# calls. 'transport' talks to a real companion server at
# VITE_COMPANION_BASE_URL. There is no real server yet, so 'transport' will
# just fail to connect today; that is expected, not a bug.
VITE_COMPANION_MODE=mock

# Base URL of a real companion server, once one exists. Never commit a real
# value here.
VITE_COMPANION_BASE_URL=https://example.invalid

# Bearer token for a real paired device, once a pairing protocol exists.
# Never a real token in this file. Read only by the transport adapter; the
# mock adapter ignores it entirely.
VITE_COMPANION_DEV_TOKEN=
